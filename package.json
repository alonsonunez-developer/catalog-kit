{
  "name": "@alonsonunez-developer/catalog-kit",
  "repository": { "type": "git", "url": "git+https://github.com/alonsonunez-developer/catalog-kit.git" },
  "publishConfig": { "registry": "https://npm.pkg.github.com" },
  "version": "0.1.0",
  "type": "module",
  "files": [
    "dist"
  ],
  "sideEffects": [
    "*.css"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./style.css": "./dist/style.css"
  },
  "scripts": {
    "prepublishOnly": "pnpm test && pnpm build",
    "dev": "vite --config playground/vite.config.ts",
    "play": "vite --config playground/vite.config.ts",
    "build": "vite build --config vite.lib.config.ts",
    "build:watch": "vite build --watch --config vite.lib.config.ts",
    "typecheck": "vue-tsc -b",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "peerDependencies": {
    "vue": "^3.5.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.13.3",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vue/test-utils": "^2.5.1",
    "@vue/tsconfig": "^0.9.1",
    "jsdom": "^30.1.1",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "vite-plugin-dts": "^5.1.1",
    "vitest": "^5.0.2",
    "vue-tsc": "^3.3.11"
  }
}
